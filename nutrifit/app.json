{
  "expo": {
    "name": "NutriFit",
    "slug": "nutrifit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D12",
    "primaryColor": "#0B0D12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andres.nutrifit",
      "backgroundColor": "#0B0D12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#0B0D12",
      "themeColor": "#0B0D12"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "cameraPermission": "NutriFit usa la cámara para fotografiar tus platos y estimar sus macros.",
          "photosPermission": "NutriFit accede a tus fotos para analizar platos de comida."
        }
      ]
    ]
  }
}
